failures 0
plugin cwebp | cwebp | names ["cwebp"] | paths ["/opt/homebrew/bin", "/usr/local/bin"] | version ["-version"]
  install webp https://developers.google.com/speed/webp/download | jobs - | cost - | timeout -
  edge ["png"] > ["webp"] | op - | flags ["lossy"] | cost - | out - | ["-quiet", "-q", "{quality:80}", "{input}", "-o", "{output}"]
  registers png > webp | cwebp | op - | cost 30 | flags 1
